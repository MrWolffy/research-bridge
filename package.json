{
  "name": "research-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP bridge for observable, steerable Codex research tasks",
  "type": "module",
  "bin": {
    "research-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "tunnel:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/secure-tunnel.ps1 -TunnelAction init",
    "tunnel:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/secure-tunnel.ps1 -TunnelAction doctor",
    "tunnel:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/secure-tunnel.ps1 -TunnelAction run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.147.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
